# Copy to .env before running `docker compose up`. Both secrets are required:
# compose refuses to start if either is missing, rather than falling back to a
# publicly known default that would make every stored secret trivially readable.
#
#   cp .env.example .env
#   openssl rand -base64 32   # -> APP_MASTER_KEY
#   openssl rand -hex 32      # -> DEVICE_ASSET_SIGNING_KEY

# 32 raw bytes, base64url encoded. Encrypts third-party source credentials and
# device MQTT passwords at rest. Rotating this key invalidates existing
# ciphertexts, so back it up somewhere safe.
APP_MASTER_KEY=

# HMAC key for signed device asset URLs. Rotating it invalidates outstanding
# links, which expire after an hour anyway.
DEVICE_ASSET_SIGNING_KEY=

# Public base URL of the console. Also used as the WebAuthn origin and RP ID
# host, so it must match the host you actually browse to.
APP_URL=http://localhost:3000
