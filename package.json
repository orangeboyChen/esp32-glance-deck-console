{
  "name": "@glance-deck/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && tsc --noEmit --project tsconfig.lint.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "render:display-doc-images": "bun scripts/render-display-doc-images.ts",
    "test:coverage": "bun test --max-concurrency=1 --isolate --coverage --coverage-reporter=lcov && bun scripts/check-coverage.ts coverage/lcov.info 90",
    "worker": "bun --bun src/worker.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@lobehub/ui": "5.29.1",
    "@resvg/resvg-js": "^2.6.2",
    "@simplewebauthn/server": "^13.3.2",
    "@simplewebauthn/types": "^12.0.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "jotai": "^2.20.2",
    "lucide-react": "^1.31.0",
    "mqtt": "^5.15.2",
    "next": "16.0.10",
    "next-intl": "^4.13.6",
    "postgres": "^3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.10.2",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "prettier": "^3.9.6",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.67.0"
  }
}
